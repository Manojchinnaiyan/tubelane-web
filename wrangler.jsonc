// ── Wrangler config — Cloudflare Workers static-assets + dynamic API ────
// Hybrid setup: a Worker entry script handles dynamic routes
// (/api/subscribe, /api/list), and any URL it doesn't recognise falls
// through to the static-assets handler which serves files from ./dist.
//
// Apply schema once after creating the D1 database (see README):
//   npx wrangler d1 execute tubelane-beta --remote --file=./schema.sql
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tubelane-web",

  // The compat date pins the runtime feature set. Bump when you want to
  // opt into newer Workers runtime APIs.
  "compatibility_date": "2026-05-07",

  // Worker entry — TypeScript file at ./src/worker.ts. Wrangler builds
  // it automatically with esbuild.
  "main": "src/worker.ts",

  // Static-assets fallback. Anything the Worker doesn't handle gets
  // served directly from ./dist via the ASSETS binding.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // D1 database — beta signup capture. Replace `database_id` after you
  // run `wrangler d1 create tubelane-beta` for the first time (Wrangler
  // prints the ID to copy in here).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tubelane-beta",
      "database_id": "a679cdb1-ca4d-4a3f-8bf8-d855202d7e07"
    }
  ],

  // Light-touch observability. Static-asset traffic is free; the
  // /api/* routes will be the only thing that shows up in logs.
  "observability": {
    "enabled": true
  }
}
