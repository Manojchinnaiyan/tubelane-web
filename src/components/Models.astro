---
// ── Models — Orbital rings (offset-path) ───────────────────────────────────
// Three concentric rings with model badges orbiting at different speeds.
// Uses CSS Motion Path (`offset-path: circle()`) so each badge follows a
// real circular path — no broken translate hacks. Each ring spins at a
// different duration; alternating directions keep adjacent rings from
// looking like one rigid wheel.
//
// Mobile collapses to a stacked list (orbital animation hidden under md).

type Model = { name: string; tag: string };

// Inner ring — language. Smallest radius, fastest revolution.
const INNER: Model[] = [
  { name: "Claude Opus", tag: "L" },
  { name: "Claude Sonnet", tag: "L" },
  { name: "Claude Haiku", tag: "L" },
];

// Middle ring — audio. Counter-rotates so the rings don't all turn together.
const MIDDLE: Model[] = [
  { name: "Google TTS", tag: "A" },
  { name: "ElevenLabs", tag: "A" },
  { name: "Chatterbox", tag: "A" },
  { name: "Whisper", tag: "A" },
];

// Outer ring — vision. Largest radius, slowest revolution.
const OUTER: Model[] = [
  { name: "Gemini 3 Pro", tag: "V" },
  { name: "Gemini 3.1 Flash", tag: "V" },
  { name: "Gemini 2.5 Flash", tag: "V" },
  { name: "Imagen 4 Ultra", tag: "V" },
  { name: "Imagen 4", tag: "V" },
  { name: "Imagen 4 Fast", tag: "V" },
  { name: "gpt-image-1", tag: "V" },
  { name: "DALL·E 3", tag: "V" },
];

// Spread badges evenly along the path via negative animation-delay. Badge i
// of N starts at (i / N) of the way through the cycle, so at t=0 the ring
// already shows them positioned around the circle. Total duration determines
// how fast the ring spins.
const OUTER_DUR = 90;   // seconds
const MIDDLE_DUR = 60;
const INNER_DUR = 40;
---

<section id="models" class="border-t border-surface-700 bg-surface-800/30 relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-20 sm:py-32">
    <div class="reveal max-w-2xl mb-12 sm:mb-16 mx-auto text-center">
      <p class="text-xs font-mono text-accent mb-3 tracking-wider">$ models</p>
      <h2 class="text-3xl sm:text-5xl font-semibold tracking-tight text-surface-50 mb-4 leading-tight">
        The orchestration stack.<br/>
        <span class="text-surface-400">Mix and match per stage.</span>
      </h2>
      <p class="text-surface-300 leading-relaxed">
        Use the cheapest model that gets the job done; bring in the premium
        tier when it matters. All providers, all your keys, never locked
        into one.
      </p>
    </div>

    {/* ── Orbital diagram (desktop) ─────────────────────────────── */}
    <div class="reveal hidden md:block">
      <div class="orbital-stage relative mx-auto">

        {/* Decorative dashed ring rails (no animation) */}
        <div class="orbit-rail orbit-rail-outer"></div>
        <div class="orbit-rail orbit-rail-middle"></div>
        <div class="orbit-rail orbit-rail-inner"></div>

        {/* Centre core — Tubelane wordmark with halo */}
        <div class="orbit-core">
          <div class="orbit-core-glow"></div>
          <div class="orbit-core-disc">
            <span class="text-[10px] font-mono text-accent tracking-widest uppercase">tubelane</span>
            <span class="text-[8px] font-mono text-surface-500 mt-1">orchestrator</span>
          </div>
        </div>

        {/* Outer ring — vision (CW, 90s) */}
        {OUTER.map((m, i) => (
          <div
            class="orbit-badge ring-outer"
            style={`animation-delay: ${-OUTER_DUR * i / OUTER.length}s;`}
          >
            <span class="orbit-tag">[{m.tag}]</span>
            <span>{m.name}</span>
          </div>
        ))}

        {/* Middle ring — audio (CCW, 60s) */}
        {MIDDLE.map((m, i) => (
          <div
            class="orbit-badge ring-middle"
            style={`animation-delay: ${-MIDDLE_DUR * i / MIDDLE.length}s;`}
          >
            <span class="orbit-tag">[{m.tag}]</span>
            <span>{m.name}</span>
          </div>
        ))}

        {/* Inner ring — language (CW, 40s) */}
        {INNER.map((m, i) => (
          <div
            class="orbit-badge ring-inner"
            style={`animation-delay: ${-INNER_DUR * i / INNER.length}s;`}
          >
            <span class="orbit-tag">[{m.tag}]</span>
            <span>{m.name}</span>
          </div>
        ))}

        {/* Legend */}
        <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex items-center gap-5 text-[10px] font-mono text-surface-500">
          <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-surface-50"></span> [L] language</span>
          <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-surface-200"></span> [A] audio</span>
          <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-surface-400"></span> [V] vision</span>
        </div>
      </div>
    </div>

    {/* ── Mobile fallback — stacked list ─────────────────────── */}
    <div class="md:hidden grid gap-3">
      {[
        { title: "Language", rows: INNER },
        { title: "Audio",    rows: MIDDLE },
        { title: "Vision",   rows: OUTER },
      ].map((col) => (
        <div class="reveal bg-surface-900 border border-surface-700 p-5">
          <p class="text-[10px] font-mono text-accent mb-3 uppercase tracking-widest">$ {col.title}</p>
          <ul class="grid grid-cols-2 gap-x-4 gap-y-2">
            {col.rows.map((r) => (
              <li class="text-xs font-mono text-surface-200 truncate">· {r.name}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Stage ───────────────────────────────────────────────────────────
     Square aspect ratio so the orbits are real circles regardless of
     viewport width. Capped at 720px on big screens so badges don't
     drift miles apart. */
  .orbital-stage {
    width: 100%;
    max-width: 720px;
    aspect-ratio: 1 / 1;
    position: relative;
  }

  /* Ring rails — three dashed circles. No animation, just decoration. */
  .orbit-rail {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 9999px;
    border: 1px dashed color-mix(in srgb, var(--brand-500) 25%, transparent);
    pointer-events: none;
  }
  .orbit-rail-outer  { width: 96%; height: 96%; border-color: color-mix(in srgb, var(--brand-500) 18%, transparent); }
  .orbit-rail-middle { width: 68%; height: 68%; border-color: color-mix(in srgb, var(--brand-500) 30%, transparent); }
  .orbit-rail-inner  { width: 38%; height: 38%; border-color: color-mix(in srgb, var(--brand-500) 45%, transparent); }

  /* ── Badges ──────────────────────────────────────────────────────────
     Each badge follows a circle via CSS Motion Path. The percentages on
     `circle()` resolve against the badge's containing block (the stage),
     so 48% radius = a circle hugging the outer rail. `offset-rotate: 0deg`
     keeps the badge upright (no auto-tilt to follow path direction).
     Badges are spread evenly via negative animation-delay (set inline). */
  .orbit-badge {
    position: absolute;
    top: 0; left: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px;
    background: var(--surface-800);
    border: 1px solid var(--surface-600);
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--surface-100);
    white-space: nowrap;
    box-shadow: 0 0 16px color-mix(in srgb, var(--brand-500) 8%, transparent);
    /* offset-* defaults — overridden per ring class below */
    offset-rotate: 0deg;
    offset-distance: 0%;
    will-change: offset-distance;
  }
  .orbit-badge .orbit-tag {
    color: var(--brand-500);
    font-weight: 700;
    font-size: 9px;
    letter-spacing: 0.06em;
  }

  /* Per-ring orbit definitions. The radius is set as a % of the stage
     (containing block). Animations advance offset-distance from 0→100%
     (CW) or 100→0% (CCW). */
  .orbit-badge.ring-outer {
    offset-path: circle(48% at 50% 50%);
    animation: orbit-cw 90s linear infinite;
  }
  .orbit-badge.ring-middle {
    offset-path: circle(34% at 50% 50%);
    animation: orbit-ccw 60s linear infinite;
  }
  .orbit-badge.ring-inner {
    offset-path: circle(19% at 50% 50%);
    animation: orbit-cw 40s linear infinite;
  }

  @keyframes orbit-cw  { from { offset-distance: 0%;   } to { offset-distance: 100%; } }
  @keyframes orbit-ccw { from { offset-distance: 100%; } to { offset-distance: 0%;   } }

  /* ── Centre disc ─────────────────────────────────────────────────────
     Sits absolute-centred above the rings, with a soft glow halo. */
  .orbit-core {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 22%;
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
    z-index: 5;
  }
  .orbit-core-glow {
    position: absolute;
    inset: -25%;
    border-radius: 9999px;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--brand-500) 35%, transparent), transparent 70%);
    filter: blur(24px);
    pointer-events: none;
  }
  .orbit-core-disc {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 9999px;
    background: radial-gradient(circle, var(--surface-800), var(--surface-900));
    border: 1px solid color-mix(in srgb, var(--brand-500) 50%, transparent);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 0 0 6px color-mix(in srgb, var(--brand-500) 6%, transparent),
      0 0 60px color-mix(in srgb, var(--brand-500) 20%, transparent);
  }

  /* Pause animations on hover so users can read every badge */
  .orbital-stage:hover .orbit-badge { animation-play-state: paused; }

  /* Reduced-motion: hold each badge at its starting offset (no spin).
     They still appear distributed around the rings because of the
     animation-delay, which still applies as a starting offset. */
  @media (prefers-reduced-motion: reduce) {
    .orbit-badge { animation-play-state: paused; }
  }

  /* Browsers without offset-path support fall back to all badges
     stacking at the top-left corner of the stage. We hide them in that
     case so the legend + core disc still look intentional. */
  @supports not (offset-path: circle(0)) {
    .orbit-badge { display: none; }
  }
</style>
