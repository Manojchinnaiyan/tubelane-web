---
// ── Stats band ──────────────────────────────────────────────────────────────
// 4 large animated counters arranged across a thin horizontal band. Numbers
// tick up from 0 when the band scrolls into view (same easeOutCubic
// counter system used by the CTA's "30 creators"). Acts as a typographic
// "social proof" rest stop between the dense Pipeline section and the
// orbital Models section.

const STATS = [
  { value: "8",   suffix: "+",  label: "generative models orchestrated" },
  { value: "12",  suffix: "min", label: "average topic-to-published time" },
  { value: "0",   suffix: "/mo", label: "subscriptions — your API keys, your cost" },
  { value: "100", suffix: "%",  label: "local-first — no servers, no telemetry" },
];
---

<section class="border-t border-b border-surface-700 bg-surface-800/40 relative overflow-hidden">
  <div class="absolute inset-0 bg-grid pointer-events-none opacity-40" aria-hidden="true"></div>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-14 sm:py-20 relative">
    <ul class="grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-10 md:gap-y-0">
      {STATS.map((s, i) => (
        <li
          class="reveal flex flex-col items-start md:items-center md:text-center md:border-r md:border-surface-700 last:md:border-r-0 md:px-4"
          style={`transition-delay: ${i * 80}ms`}
        >
          <div class="flex items-baseline gap-1">
            <span
              class="count-up text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-surface-50"
              data-count-to={s.value}
            >0</span>
            <span class="text-2xl sm:text-3xl font-mono text-accent">{s.suffix}</span>
          </div>
          <p class="mt-3 text-xs font-mono text-surface-400 leading-relaxed max-w-[200px]">
            {s.label}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>
